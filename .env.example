# ==============================================================================
# CROSSLIFE WEBSITE & CMS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# The website works 100% out-of-the-box in local offline mode using browser storage.
# If you wish to connect a live Supabase PostgreSQL database and media storage,
# copy this file to `.env` or set these environment variables in Vercel:
# ==============================================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=
